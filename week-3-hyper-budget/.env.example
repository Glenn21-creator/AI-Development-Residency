# Hyper Budget environment variables
#
# Copy this file to .env.local and fill in the real values there.
# .env.local is git-ignored and must NEVER be committed.
# Secret keys never go in the code or in git. This template holds blanks only.

# --- Supabase (from your Supabase project: Settings > API) ---

# Public values. Safe to expose to the browser; Row-Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Bypasses Row-Level Security.
# NEVER expose this to the browser and NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Added later, when we build those features (kept here as a reminder) ---

# Open-banking provider (sandbox):
# BANK_PROVIDER_CLIENT_ID=
# BANK_PROVIDER_CLIENT_SECRET=

# Web push signing keys (VAPID):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
